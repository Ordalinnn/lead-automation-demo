# Всё необязательно: без ключей проект работает в демо-режиме (CSV + лог)

# Разбор заявок через Claude (без ключа используются правила по ключевым словам)
ANTHROPIC_API_KEY=
# Haiku быстрый и дешёвый, для сортировки заявок его хватает.
# Для сложных случаев можно поставить claude-sonnet-5-5 или claude-opus-5-5.
CLAUDE_MODEL=claude-haiku-5-5

# Google Sheets: ID таблицы из её адреса и JSON-ключ сервисного аккаунта
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=service-account.json

# Telegram: токен от @BotFather и ID чата менеджера или группы
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Куда писать заявки в демо-режиме и при сбое Google Sheets
LEADS_CSV=data/leads.csv

# Ключ для адреса вебхука: /webhook?key=ВАШ_КЛЮЧ. Без ключа вебхук открыт всем
WEBHOOK_SECRET=
